# Copy this file to .env (same folder) and fill in your project's values,
# from the Supabase dashboard's Project Settings: the Project URL, and the
# secret key (older projects call it service_role).
# The secret key bypasses row level security: keep .env out of git and
# never share it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
